rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép người dùng đọc và ghi vào document của chính họ dựa trên UID xác thực
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Cho phép người dùng đã xác thực đọc cấu hình và dữ liệu hệ thống (như bảng xếp hạng)
    match /system/{document=**} {
      allow read: if request.auth != null;
    }
  }
}
